# gaik-hackathon environment: names only. Copy to .env (gitignored) and fill in, or let the
# launcher supply them. Rahti gets them from secrets. See docs/ARCHITECTURE.md section 5.

# Azure OpenAI, read by the gaik library under these names
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_API_VERSION=
# chat deployment name
AZURE_DEPLOYMENT=
# audio transcription deployment name
AZURE_TRANSCRIPTION_MODEL=
# embedding deployment name
EMBEDDING_MODEL=

# Azure Realtime (voice call): a different host than chat
AZURE_REALTIME_ENDPOINT=
AZURE_REALTIME_API_KEY=
AZURE_REALTIME_DEPLOYMENT=

# Speech out
AZURE_TTS_MODEL=
TTS_ENDPOINT=

# gaik-decide (Jev typed decisions): root URL without /v1; in the cluster http://gaik-decide:8080
GAIK_DECIDE_URL=
GAIK_DECIDE_API_KEY=

# Browser login (HTTP Basic, then a signed session cookie)
HACK_BASIC_USER=
HACK_BASIC_PASSWORD=
# signs the session cookie: a random string of 32 characters or more
HACK_SESSION_SECRET=
# bearer key of the WhatsApp bridge: its session and long poll, intake, approve and correct,
# one report and its files, the call WebSocket. Nothing else.
HACK_BRIDGE_KEY=
# bearer key of MCP clients: /mcp only. Must differ from the bridge key.
HACK_MCP_KEY=
# 1 switches access control off. The server refuses to start with it unless PUBLIC_BASE_URL
# is on http://localhost or http://127.0.0.1
HACK_AUTH_DISABLED=
# 1 allows the dev front end at http://localhost:3000 (CORS and Origin). Same rule as above.
HACK_DEV=
# 1 answers every model-backed route with 503 (the switch for a runaway bill)
HACK_MODELS_OFF=

# folder for app.db and files; default ./.data under the repository root
DATA_DIR=
# public origin (https://host, or http://localhost:8787 locally): the only Origin a browser
# may write from, and the address in emails and MCP instructions
PUBLIC_BASE_URL=

# outbound mail: an empty host means mail is disabled (messages go to DATA_DIR/outbox)
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=
# comma-separated allowlist; mail to any other address is refused
MAIL_ALLOWED_TO=
# where an approval without a recipient goes; one of MAIL_ALLOWED_TO, default its first entry
MAIL_DEFAULT_TO=
# most messages sent in an hour; default 10
MAIL_MAX_PER_HOUR=
